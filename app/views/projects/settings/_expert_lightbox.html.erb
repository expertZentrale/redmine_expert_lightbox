<%# Per-project override of the inline image size limit. Without an active override
    the project follows the global setting shown below the fields. %>
<% setting = ExpertLightboxProjectSetting.find_or_initialize_by(:project_id => @project.id) %>
<% global = ExpertLightboxProjectSetting.global_limits %>
<%= form_tag expert_lightbox_project_settings_path(@project), :method => :patch do %>
  <fieldset class="box tabular">
    <legend><%= l(:label_expert_lightbox_inline_size) %></legend>
    <p>
      <label for="expert_lightbox_project_setting_override"><%= l(:label_expert_lightbox_override) %></label>
      <%= hidden_field_tag 'expert_lightbox_project_setting[override]', '0', :id => nil %>
      <%= check_box_tag 'expert_lightbox_project_setting[override]', '1', setting.override?,
                        :id => 'expert_lightbox_project_setting_override' %>
    </p>
    <p>
      <label for="expert_lightbox_project_setting_inline_max_width"><%= l(:label_expert_lightbox_inline_max_width) %></label>
      <%= number_field_tag 'expert_lightbox_project_setting[inline_max_width]', setting.inline_max_width,
                           :min => 1, :max => ExpertLightboxProjectSetting::MAX_PX, :step => 1, :size => 6, :id => 'expert_lightbox_project_setting_inline_max_width' %> px
    </p>
    <p>
      <label for="expert_lightbox_project_setting_inline_max_height"><%= l(:label_expert_lightbox_inline_max_height) %></label>
      <%= number_field_tag 'expert_lightbox_project_setting[inline_max_height]', setting.inline_max_height,
                           :min => 1, :max => ExpertLightboxProjectSetting::MAX_PX, :step => 1, :size => 6, :id => 'expert_lightbox_project_setting_inline_max_height' %> px
      <em class="info"><%= l(:text_expert_lightbox_inline_size) %></em>
    </p>
    <p>
      <label><%= l(:label_expert_lightbox_global_setting) %></label>
      <%= l(:label_expert_lightbox_inline_max_width) %>: <%= global[:width] ? "#{global[:width]} px" : l(:label_expert_lightbox_no_limit) %>,
      <%= l(:label_expert_lightbox_inline_max_height) %>: <%= global[:height] ? "#{global[:height]} px" : l(:label_expert_lightbox_no_limit) %>
    </p>
  </fieldset>
  <%= submit_tag l(:button_save) %>
<% end %>
